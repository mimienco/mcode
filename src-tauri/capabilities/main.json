{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum capabilities for the primary local MCode window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "allow-app-get-launch-context",
    "allow-terminal-preview-ack",
    "allow-terminal-preview-connect",
    "allow-terminal-preview-fit",
    "allow-terminal-preview-input",
    "allow-terminal-preview-unsubscribe",
    "allow-ui-notification-dispatch",
    "allow-ui-notification-dismiss",
    "allow-ui-notification-get-permission-status",
    "allow-ui-notification-open-system-settings",
    "allow-ui-clipboard-read-text",
    "allow-ui-clipboard-write-text",
    "allow-ui-clipboard-write-terminal-text",
    "allow-ui-consume-pending-skill-share",
    "allow-ui-open-settings",
    "allow-ui-pick-floating-markdown-document",
    "allow-ui-pick-floating-workspace-directory",
    "allow-ui-consume-pending-open-settings",
    "allow-ui-open-setup-guide",
    "allow-ui-open-feature-tour",
    "allow-ui-open-crash-report",
    "allow-ui-export-html-to-pdf",
    "allow-app-stage-shutdown-checkpoint",
    "allow-app-request-shutdown",
    "allow-app-acknowledge-shutdown",
    "allow-app-cancel-shutdown",
    "allow-app-confirm-and-execute-shutdown",
    "allow-window-hide-to-tray-if-enabled",
    "allow-window-set-minimize-to-tray-on-close",
    "allow-update-get-status",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install",
    "allow-developer-permissions-get-status",
    "allow-developer-permissions-request",
    "allow-developer-permissions-open-settings",
    "allow-developer-permissions-test-local-network-connection",
    "allow-ui-speech-get-catalog",
    "allow-ui-speech-get-model-states",
    "allow-ui-speech-download-model",
    "allow-ui-speech-cancel-download",
    "allow-ui-speech-start-dictation",
    "allow-ui-speech-feed-audio",
    "allow-ui-speech-stop-dictation"
  ]
}
