{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCode",
  "version": "1.4.178",
  "identifier": "com.mcode.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm run dev:tauri-renderer",
    "beforeBuildCommand": "corepack pnpm run build:tauri-renderer",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: data: blob:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["mcode"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "../resources/notification-sounds": "notification-sounds",
      "../resources/plugins/launch": "plugins/launch",
      "../resources/onboarding/feature-wall": "onboarding/feature-wall",
      "../resources/skills": "skills"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
