{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/renderer/src/**/*.tsx",
    "../src/preload/api-types.ts",
    "../src/preload/api/**/*",
    "../src/shared/**/*",
    "../package.json",
    "../src/renderer/src/**/*.json",
    "../src/shared/**/*.json"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "../out/tsc-web",
    "rootDir": "..",
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
